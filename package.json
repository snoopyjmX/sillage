{
  "name": "sillage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "analyze": "ANALYZE=1 vite build",
    "ingest": "node scripts/ingest-perfume.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "check:contrast": "node scripts/verify-contrast.js",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts && prettier --write src/types/database.types.ts",
    "db:fake": "supabase db query --local -f supabase/dev/fake-perfumes.sql",
    "db:fake:e2e": "supabase db query --local -f supabase/dev/fake-perfumes-e2e.sql",
    "db:fake:clear": "supabase db query --local -f supabase/dev/fake-perfumes-clear.sql",
    "e2e": "playwright test",
    "images": "node scripts/process-images.mjs",
    "images:download": "node scripts/download-images.mjs",
    "images:upload": "node scripts/upload-images.mjs",
    "images:all": "npm run images:download && npm run images && node scripts/upload-images.mjs",
    "og-image": "node scripts/og-image.mjs",
    "images:preview": "node scripts/preview-images.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.27.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
