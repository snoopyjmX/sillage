# Copie para .env.local e preencha com os valores do Supabase local:
#   npx supabase status -o env   (use API_URL e ANON_KEY)
# Só a chave anon (pública por desenho) vai para o front. NUNCA coloque service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só para scripts/upload-images.mjs (roda no Node, nunca no front; sem prefixo VITE_):
#   SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY de `npx supabase status -o env`>
