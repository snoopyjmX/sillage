{
  "name": "sillage-linkedin-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vídeo promocional do Sillage para o LinkedIn (Remotion), isolado do app",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "capture": "node scripts/capture-screens.mjs",
    "studio": "npm run setup && remotion studio",
    "render": "npm run setup && remotion render src/index.ts SillageShowcase out/sillage-linkedin-showcase.mp4 --codec=h264 --crf=18",
    "stills": "node scripts/render-stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
